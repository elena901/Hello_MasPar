uniform int32 a[16][16] = {{0}};

void main(/*...*/){

   set_mask(mask<<4, 4>, <4, 4>>); //last axes could be assigned to different execution cores

   foreach(i = 0 ... 15){
      foreach(j = 0 ... 15){
         a[i][j] = threadIndex;
      }
   }

   print(a); //fat-pointer
   return;
}

